    "react-dom": "19.0.0-rc-512b09b2-20240718",
    "sharp": "0.32.6"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "eslint": "^8.57.0",
